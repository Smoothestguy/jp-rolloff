---
title: "Book a Dumpster | JP Roll-Off Service"
description: "Book your roll-off dumpster in the DMV. Pick a size, tell us where and when, and we'll confirm your delivery — same-day available. (301) 252-3586."
canonical: "https://jprolloff.com/book"
navActive: "/book"
quoteHref: "#book-form"
eleventyExcludeFromCollections: true
---
{% extends "base.njk" %}

{% block content %}
<main id="main">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow" style="color:#fff;" data-en="Book Online · 60-Second Form" data-es="Reserva Online · 60 Seg">Book Online · 60-Second Form</span>
      <h1>Book your <span id="book-size-label" class="accent">dumpster</span>.</h1>
      <p data-en="Pick your size, tell us where and when, and we'll confirm your delivery — usually within the hour during business hours. Same-day available across most of the DMV." data-es="Elige el tamaño, dinos dónde y cuándo, y confirmamos tu entrega — normalmente en menos de una hora en horario laboral. Mismo día disponible en casi todo el DMV.">Pick your size, tell us where and when, and we'll confirm your delivery — usually within the hour during business hours. Same-day available across most of the DMV.</p>
    </div>
  </section>

  <section class="section" id="book-form">
    <div class="container container-narrow">
      <form data-quote-form class="form-grid" novalidate>
        <div class="field">
          <label for="qf-name" data-en="Full name" data-es="Nombre completo">Full name</label>
          <input id="qf-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="qf-phone" data-en="Phone" data-es="Teléfono">Phone</label>
          <input id="qf-phone" name="phone" type="tel" autocomplete="tel" required />
        </div>
        <div class="field field-full">
          <label for="qf-email" data-en="Email" data-es="Email">Email</label>
          <input id="qf-email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="field field-full">
          <label for="qf-address" data-en="Service address" data-es="Dirección de servicio">Service address</label>
          <input id="qf-address" name="address" type="text" autocomplete="street-address" required />
        </div>
        <div class="field">
          <label for="qf-size" data-en="Dumpster size" data-es="Tamaño">Dumpster size</label>
          <select id="qf-size" name="size" required>
            <option value="">— Select —</option>
            {% for s in sizes %}
            <option>{{ s.yd }} Yard</option>
            {% endfor %}
            <option data-en="Not sure — help me pick" data-es="No estoy seguro">Not sure — help me pick</option>
          </select>
        </div>
        <div class="field">
          <label for="qf-date" data-en="Delivery date" data-es="Fecha de entrega">Delivery date</label>
          <input id="qf-date" name="date" type="date" />
        </div>
        <div class="field field-full">
          <label for="qf-notes" data-en="Project details (optional)" data-es="Detalles (opcional)">Project details (optional)</label>
          <textarea id="qf-notes" name="notes" rows="3" placeholder="What are you tearing out / building? Any access constraints?"></textarea>
        </div>
        <div class="field-full" style="display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap;">
          <button type="submit" class="btn btn-lg" data-en="Book My Dumpster" data-es="Reservar Mi Contenedor">
            Book My Dumpster
            <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <a href="tel:{{ site.phone.tel }}" class="btn btn-lg btn-outline-light" data-en="Or call now" data-es="O llama ahora">Or call now: {{ site.phone.display }}</a>
        </div>
        <p class="field-full" style="font-size:var(--fs-14);color:var(--color-text-muted);" data-en="This sends a booking request — we confirm availability and the flat price before anything is final. No payment now." data-es="Esto envía una solicitud de reserva — confirmamos disponibilidad y el precio fijo antes de finalizar. Sin pago ahora.">This sends a booking request — we confirm availability and the flat price before anything is final. No payment now.</p>
      </form>
    </div>
  </section>

  {# Pre-fill the size from ?size=NN and personalize the heading. Runs before main.js's defer. #}
  <script>
    (function () {
      var yd = new URLSearchParams(location.search).get('size');
      if (!yd) return;
      var sel = document.getElementById('qf-size');
      if (sel) {
        for (var i = 0; i < sel.options.length; i++) {
          if (sel.options[i].text.trim() === yd + ' Yard') { sel.selectedIndex = i; break; }
        }
      }
      var label = document.getElementById('book-size-label');
      if (label) label.textContent = yd + '-yard dumpster';
    })();
  </script>
</main>
{% endblock %}
