---
title: "Contact JP Roll-Off Service · Beltsville, MD"
description: "Contact JP Roll-Off Service: (301) 879-7040 office, (301) 252-3586 secondary line. Serving Beltsville, MD and the entire DMV. Free quotes, next-day delivery."
canonical: "https://jprolloff.com/contact"
navActive: "/contact"
---
{% extends "base.njk" %}

{% block content %}
<main id="main">
    <section class="page-header">
      <div class="container">
        <span class="eyebrow" style="color:#fff;" data-en="Contact" data-es="Contacto">Contact</span>
        <h1 data-en="Contact Us Today." data-es="Contáctanos Hoy.">Contact Us Today.</h1>
        <p data-en="Whether you're ready to order or just have a question, our team is here to help." data-es="Ya sea que estés listo para ordenar o solo tengas una pregunta, nuestro equipo está aquí para ayudarte.">Whether you're ready to order or just have a question, our team is here to help.</p>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div class="area-grid" style="align-items: start;">
          <div>
            <h2 style="font-size: var(--fs-56);" data-en="Get in touch." data-es="Ponte en contacto.">Get in touch.</h2>
            <p class="lead" style="margin-top: var(--space-5);" data-en="Call or text us, send a note, or stop by. Use whichever works best for you." data-es="Llámanos o envíanos un mensaje, mándanos una nota o visítanos. Usa lo que mejor te funcione.">Call or text us, send a note, or stop by. Use whichever works best for you.</p>

            <div style="margin-top: var(--space-10); display: flex; flex-direction: column; gap: var(--space-8);">
              <div>
                <span class="eyebrow" data-en="Office" data-es="Oficina">Office</span>
                <a href="tel:+13018797040" style="display:block; font-family: var(--font-display); font-size: var(--fs-72); color: var(--color-red); letter-spacing: var(--ls-snug); line-height: 1;">(301) 879-7040</a>
              </div>
              <div>
                <span class="eyebrow" data-en="Secondary Line" data-es="Línea Secundaria">Secondary Line</span>
                <a href="tel:+13012523586" style="display:block; font-family: var(--font-display); font-size: var(--fs-40); color: var(--color-black); letter-spacing: var(--ls-snug);">(301) 252-3586</a>
              </div>
              <div>
                <span class="eyebrow" data-en="Mailing" data-es="Correo">Mailing</span>
                <p style="font-size: var(--fs-18); line-height: var(--lh-loose);">PO Box 168<br/>Beltsville, MD 20704</p>
              </div>
              <div>
                <span class="eyebrow" data-en="Hours" data-es="Horario">Hours</span>
                <p style="font-size: var(--fs-18); line-height: var(--lh-loose);" data-html data-en="Monday–Friday · 7:00 AM – 6:00 PM<br/>Saturday · 8:00 AM – 2:00 PM<br/>Sunday · Emergency service only" data-es="Lunes a viernes · 7:00 AM – 6:00 PM<br/>Sábado · 8:00 AM – 2:00 PM<br/>Domingo · Solo servicio de emergencia">Monday–Friday · 7:00 AM – 6:00 PM<br/>Saturday · 8:00 AM – 2:00 PM<br/>Sunday · Emergency service only</p>
              </div>
            </div>
          </div>

          <form data-quote-form class="form-grid" id="quote" style="background: var(--color-white); padding: var(--space-10); border-radius: var(--radius-xl); border: 1px solid var(--color-border);">
            <div class="field-full" style="display:flex; flex-direction:column; gap: var(--space-2);">
              <span class="eyebrow" data-en="Free Quote" data-es="Cotización Gratis">Free Quote</span>
              <h3 style="font-size: var(--fs-32);" data-en="Send us your project details." data-es="Cuéntanos los detalles de tu proyecto.">Send us your project details.</h3>
            </div>
            <div class="field"><label for="cf-name" data-en="Full name" data-es="Nombre completo">Full name</label><input id="cf-name" name="name" type="text" autocomplete="name" required /></div>
            <div class="field"><label for="cf-phone" data-en="Phone" data-es="Teléfono">Phone</label><input id="cf-phone" name="phone" type="tel" autocomplete="tel" required /></div>
            <div class="field field-full"><label for="cf-email" data-en="Email" data-es="Correo electrónico">Email</label><input id="cf-email" name="email" type="email" autocomplete="email" /></div>
            <div class="field field-full"><label for="cf-address" data-en="Service address" data-es="Dirección de servicio">Service address</label><input id="cf-address" name="address" type="text" autocomplete="street-address" required /></div>
            <div class="field"><label for="cf-size" data-en="Dumpster size" data-es="Tamaño del contenedor">Dumpster size</label>
              <select id="cf-size" name="size" required>
                <option value="" data-en="— Select —" data-es="— Selecciona —">— Select —</option><option>10 Yard</option><option>15 Yard</option><option>20 Yard</option><option>25 Yard</option><option>30 Yard</option><option data-en="Not sure — help me pick" data-es="No estoy seguro — ayúdame a elegir">Not sure — help me pick</option>
              </select>
            </div>
            <div class="field"><label for="cf-date" data-en="Delivery date" data-es="Fecha de entrega">Delivery date</label><input id="cf-date" name="date" type="date" /></div>
            <div class="field field-full"><label for="cf-notes" data-en="Project details (optional)" data-es="Detalles del proyecto (opcional)">Project details (optional)</label><textarea id="cf-notes" name="notes" rows="3"></textarea></div>
            <div class="field-full">
              <button type="submit" class="btn btn-lg btn-full" data-en="Send My Quote Request →" data-es="Enviar mi solicitud de cotización →">Send My Quote Request →</button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
{% endblock %}
