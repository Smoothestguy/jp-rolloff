{# Site footer — single source. Dumpster links loop over `sizes`; areas from site.footerAreas. #}
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <img src="/images/JPRolloff.png" alt="JP Roll-Off Service" class="footer-logo" />
        <p class="footer-tagline" data-en="Family-owned dumpster rental serving the DMV since 2000. Next-day delivery, transparent pricing, and real people ready to help." data-es="Renta de contenedores, empresa familiar sirviendo el DMV desde el año 2000. Entrega al día siguiente, precios transparentes y personas reales listas para ayudar.">Family-owned dumpster rental serving the DMV since 2000. Next-day delivery, transparent pricing, and real people ready to help.</p>
        <div class="footer-contact">
          <span><strong>{{ site.phone.display }}</strong> <span style="color:var(--color-gray-500)" data-en="· office" data-es="· oficina">· office</span></span>
          <span>{{ site.phone.secondary.display }} <span style="color:var(--color-gray-500)" data-en="· secondary" data-es="· secundaria">· secondary</span></span>
          <span>{{ site.address }}</span>
          <span data-en="Mon–Fri 7a–6p · Sat 7a–12p · Sun Closed" data-es="Lun–Vie 7a–6p · Sáb 7a–12p · Dom Cerrado">Mon–Fri 7a–6p · Sat 7a–12p · Sun Closed</span>
        </div>
      </div>

      <div>
        <h5 data-en="Dumpsters" data-es="Contenedores">Dumpsters</h5>
        <ul>
          {% for s in sizes %}
          <li><a href="/services/{{ s.slug }}">{{ s.yd }} Yard Dumpster</a></li>
          {% endfor %}
          <li><a href="/demolition" data-en="Demolition Services" data-es="Servicios de Demolición">Demolition Services</a></li>
          <li><a href="/emergency" data-en="Emergency Services" data-es="Servicios de Emergencia">Emergency Services</a></li>
          <li><a href="/services" data-en="All services →" data-es="Todos →">All services →</a></li>
        </ul>
      </div>

      <div>
        <h5 data-en="Areas" data-es="Áreas">Areas</h5>
        <ul>
          {% for a in site.footerAreas %}
          <li><a href="{{ a.href }}">{{ a.label }}</a></li>
          {% endfor %}
          <li><a href="/service-areas" data-en="All areas →" data-es="Todas →">All areas →</a></li>
        </ul>
      </div>

      <div>
        <h5 data-en="Company" data-es="Empresa">Company</h5>
        <ul>
          <li><a href="/about" data-en="About" data-es="Acerca">About</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact" data-en="Contact" data-es="Contacto">Contact</a></li>
          <li><a href="/#quote" data-en="Free Quote" data-es="Cotización Gratis">Free Quote</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© <span data-year>2026</span> JP Roll-Off Service, Inc.</span>
      <span data-en="Silver Spring, MD · Se Habla Español" data-es="Silver Spring, MD · Se Habla Español">Silver Spring, MD · Se Habla Español</span>
      <span>
        <a href="/privacy" data-en="Privacy Policy" data-es="Política de Privacidad">Privacy Policy</a> · <a href="/terms">Terms</a>
      </span>
    </div>
  </div>
</footer>
