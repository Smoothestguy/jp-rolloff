{# Primary navigation. Reads site.nav. Page context may set navActive (href to mark current) and quoteHref. #}
{% set quoteHref = quoteHref or "/#quote" %}
<header class="nav" id="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="JP Roll-Off Service home">
      <img src="/images/JPRolloff.png" alt="JP Roll-Off Service" class="nav-logo nav-logo-default" />
      <img src="/images/JPRolloffBlack.png" alt="" aria-hidden="true" class="nav-logo nav-logo-scrolled" />
    </a>

    <nav class="nav-menu" aria-label="Primary">
      {% for item in site.nav %}
      <a href="{{ item.href }}"{% if item.href == navActive %} aria-current="page"{% endif %} data-en="{{ item.label.en }}" data-es="{{ item.label.es }}">{{ item.label.en }}</a>
      {% endfor %}
    </nav>

    <div class="nav-actions">
      <button class="lang-toggle" data-lang-toggle aria-label="Toggle language">
        <span data-lang="EN" class="lang-active">EN</span>
        <span>/</span>
        <span data-lang="ES">ES</span>
      </button>
      <a class="nav-phone" href="tel:{{ site.phone.tel }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {{ site.phone.display }}
      </a>
      <a href="{{ quoteHref }}" class="btn btn-sm" data-quote-open data-en="Free Quote" data-es="Cotización">Free Quote</a>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
        <span class="nav-toggle-bars"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="nav-mobile" id="nav-mobile">
    {% for item in site.nav %}
    <a href="{{ item.href }}" data-en="{{ item.label.en }}" data-es="{{ item.label.es }}">{{ item.label.en }}</a>
    {% endfor %}
    <a href="{{ quoteHref }}" class="btn" data-quote-open data-en="Get Your Free Quote →" data-es="Solicita tu Cotización Gratis →">Get Your Free Quote →</a>
    <div class="nav-mobile-meta">
      <a href="tel:{{ site.phone.tel }}"><strong>{{ site.phone.display }}</strong></a>
      <a href="tel:{{ site.phone.secondary.tel }}">{{ site.phone.secondary.display }}</a>
      <button class="lang-toggle" data-lang-toggle aria-label="Toggle language" style="align-self:flex-start">
        <span data-lang="EN" class="lang-active">EN</span><span>/</span><span data-lang="ES">ES</span>
      </button>
    </div>
  </div>
</header>
