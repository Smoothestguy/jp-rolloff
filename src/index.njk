            <blockquote data-en="“We've run our remodeling business for 12 years and JP has been our roll-off vendor for the last six. They never no-show. They take Spanish-language calls. They are simply the standard.”" data-es="“Llevamos 12 años con nuestra empresa de remodelación y JP ha sido nuestro proveedor por los últimos seis. Nunca faltan. Atienden en español. Son simplemente el estándar.”">“We've run our remodeling business for 12 years and JP has been our roll-off vendor for the last six. They never no-show. They take Spanish-language calls. They are simply the standard.”</blockquote>
            <div class="testimonial-author">
              <div class="testimonial-avatar">DG</div>
              <div>
                <strong>Diego G.</strong>
                <span data-en="Remodeler · Hyattsville" data-es="Remodelador · Hyattsville">Remodeler · Hyattsville</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============= QUOTE FORM ============= -->
    <section class="section" id="quote">
      <div class="container">
        <div class="quote-band reveal">
          <div>
            <span class="chip chip-dark" data-en="Free Quote · 60-Second Form" data-es="Cotización Gratis · 60 Seg">Free Quote · 60-Second Form</span>
            <h2 style="margin-top: var(--space-4);" data-en="Get your price in writing — today." data-es="Recibe tu precio por escrito — hoy.">Get your price in writing — today.</h2>
            <p data-en="Tell us where, what, and when. We'll text or email a flat-rate quote within the hour during business hours." data-es="Dinos dónde, qué y cuándo. Te enviamos un precio fijo por mensaje o email en menos de una hora durante horario laboral.">Tell us where, what, and when. We'll text or email a flat-rate quote within the hour during business hours.</p>

            <ul class="quote-perks">
              <li><div><strong data-en="One-call delivery" data-es="Entrega de una llamada">One-call delivery</strong><span data-en="Most quotes can be scheduled the same day." data-es="La mayoría de cotizaciones se pueden agendar el mismo día.">Most quotes can be scheduled the same day.</span></div></li>
              <li><div><strong data-en="No hidden fees" data-es="Sin cargos ocultos">No hidden fees</strong><span data-en="Quote = price. Tonnage included." data-es="Cotización = precio. Peso incluido.">Quote = price. Tonnage included.</span></div></li>
              <li><div><strong data-en="Bilingual office" data-es="Oficina bilingüe">Bilingual office</strong><span data-en="Atendemos llamadas y formularios en español." data-es="Atendemos llamadas y formularios en español.">Atendemos llamadas y formularios en español.</span></div></li>
            </ul>
          </div>

          <form data-quote-form class="form-grid" novalidate>
            <div class="field">
              <label for="qf-name" data-en="Full name" data-es="Nombre completo">Full name</label>
              <input id="qf-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="qf-phone" data-en="Phone" data-es="Teléfono">Phone</label>
              <input id="qf-phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
            <div class="field field-full">
              <label for="qf-email" data-en="Email" data-es="Email">Email</label>
              <input id="qf-email" name="email" type="email" autocomplete="email" />
            </div>
            <div class="field field-full">
              <label for="qf-address" data-en="Service address" data-es="Dirección de servicio">Service address</label>
              <input id="qf-address" name="address" type="text" autocomplete="street-address" required />
            </div>
            <div class="field">
              <label for="qf-size" data-en="Dumpster size" data-es="Tamaño">Dumpster size</label>
              <select id="qf-size" name="size" required>
                <option value="">— Select —</option>
                {% for s in sizes %}
                <option>{{ s.yd }} Yard</option>
                {% endfor %}
                <option data-en="Not sure — help me pick" data-es="No estoy seguro">Not sure — help me pick</option>
              </select>
            </div>
            <div class="field">
              <label for="qf-date" data-en="Delivery date" data-es="Fecha de entrega">Delivery date</label>
              <input id="qf-date" name="date" type="date" />
            </div>
            <div class="field field-full">
              <label for="qf-notes" data-en="Project details (optional)" data-es="Detalles (opcional)">Project details (optional)</label>
              <textarea id="qf-notes" name="notes" rows="3" placeholder="What are you tearing out / building? Any access constraints?"></textarea>
            </div>
            <div class="field-full" style="display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap;">
              <button type="submit" class="btn btn-lg" data-en="Send My Quote Request" data-es="Enviar Solicitud">
                Send My Quote Request
                <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
              <a href="tel:{{ site.phone.tel }}" class="btn btn-lg btn-outline-light" data-en="Or call now" data-es="O llama ahora">Or call now: {{ site.phone.display }}</a>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- ============= FAQ ============= -->
    <section class="section section-alt">
      <div class="container container-narrow">
        <div class="section-head reveal" style="grid-template-columns: 1fr;">
          <div>
            <span class="eyebrow" data-en="FAQ" data-es="Preguntas">FAQ</span>
            <h2 data-en="The questions we get most." data-es="Las preguntas más frecuentes.">The questions we get most.</h2>
          </div>
        </div>

        <div class="faq-list reveal">
          <details class="faq-item" open>
            <summary data-en="How fast can I get a dumpster?" data-es="¿Qué tan rápido recibo un contenedor?">How fast can I get a dumpster?</summary>
            <div class="faq-answer" data-en="Most addresses in our core service area (Beltsville, Greenbelt, College Park, Laurel, Hyattsville) can be delivered the same day if you call before noon. Outside that radius, next-day is standard." data-es="La mayoría de direcciones en nuestra área principal (Beltsville, Greenbelt, College Park, Laurel, Hyattsville) reciben entrega el mismo día si llamas antes del mediodía. Fuera de ese radio, día siguiente es lo estándar.">Most addresses in our core service area (Beltsville, Greenbelt, College Park, Laurel, Hyattsville) can be delivered the same day if you call before noon. Outside that radius, next-day is standard.</div>
          </details>
          <details class="faq-item">
            <summary data-en="What size dumpster do I need?" data-es="¿Qué tamaño necesito?">What size dumpster do I need?</summary>
            <div class="faq-answer" data-en="As a rule of thumb: 10 yard for garage cleanouts, 15 for single-room remodels, 20 for whole-house cleanouts (our most popular), 25 for additions, and 30 for full demolitions or large construction. Call us — we'll help you pick the right one." data-es="Regla general: 10 yardas para garajes, 15 para una habitación, 20 para casas completas (el más popular), 25 para adiciones, y 30 para demoliciones o construcción grande. Llámanos — te ayudamos a elegir.">As a rule of thumb: 10 yard for garage cleanouts, 15 for single-room remodels, 20 for whole-house cleanouts (our most popular), 25 for additions, and 30 for full demolitions or large construction. Call us — we'll help you pick the right one.</div>
          </details>
          <details class="faq-item">
            <summary data-en="How much does it cost?" data-es="¿Cuánto cuesta?">How much does it cost?</summary>
            <div class="faq-answer" data-en="Flat-rate pricing depends on size and ZIP code. Typical 20-yard rentals in our core area run around $450–$525 for a 7-day rental with tonnage included. Every quote is in writing — what we quote is what you pay." data-es="El precio fijo depende del tamaño y código postal. Una renta típica de 20 yardas en el área principal cuesta entre $450–$525 por 7 días con peso incluido. Cada cotización es por escrito — lo cotizado es lo que pagas.">Flat-rate pricing depends on size and ZIP code. Typical 20-yard rentals in our core area run around $450–$525 for a 7-day rental with tonnage included. Every quote is in writing — what we quote is what you pay.</div>
          </details>
          <details class="faq-item">
            <summary data-en="What can I put in the dumpster?" data-es="¿Qué puedo poner en el contenedor?">What can I put in the dumpster?</summary>
            <div class="faq-answer" data-en="Most construction, demo, household, and yard debris. We can't take: hazardous waste (paints, solvents, oils), tires, batteries, refrigerators with refrigerant, propane tanks, or asbestos. Ask if you're unsure — we'll point you to the right disposal." data-es="La mayoría de escombros de construcción, demolición, hogar y jardín. No aceptamos: desechos peligrosos (pinturas, solventes, aceites), llantas, baterías, refrigeradores con refrigerante, tanques de propano, o asbesto. Si no estás seguro, pregúntanos.">Most construction, demo, household, and yard debris. We can't take: hazardous waste (paints, solvents, oils), tires, batteries, refrigerators with refrigerant, propane tanks, or asbestos. Ask if you're unsure — we'll point you to the right disposal.</div>
          </details>
          <details class="faq-item">
            <summary data-en="Do I need a permit?" data-es="¿Necesito un permiso?">Do I need a permit?</summary>
            <div class="faq-answer" data-en="Permits are only needed if the dumpster sits in the street or public right-of-way. Most driveways and private lots are permit-free. Each city handles it differently — we'll help you figure it out for your address." data-es="Solo se necesita permiso si el contenedor va en la calle o derecho de vía pública. Casi todas las entradas privadas no requieren permiso. Cada ciudad es distinta — te ayudamos a verificar para tu dirección.">Permits are only needed if the dumpster sits in the street or public right-of-way. Most driveways and private lots are permit-free. Each city handles it differently — we'll help you figure it out for your address.</div>
          </details>
          <details class="faq-item">
            <summary data-en="How long can I keep the dumpster?" data-es="¿Cuánto tiempo lo puedo tener?">How long can I keep the dumpster?</summary>
            <div class="faq-answer" data-en="Standard rental is 7 days. Need more? Day extensions are inexpensive — just call. Need it gone sooner? Same-day pickup available in most cases." data-es="La renta estándar es 7 días. ¿Necesitas más? Las extensiones por día son económicas — solo llama. ¿Lo necesitas antes? Recogida el mismo día disponible en la mayoría de casos.">Standard rental is 7 days. Need more? Day extensions are inexpensive — just call. Need it gone sooner? Same-day pickup available in most cases.</div>
          </details>
        </div>

        <div class="text-center" style="margin-top: var(--space-12);">
          <a href="/faq" class="btn btn-secondary" data-en="See all FAQs" data-es="Ver todas las preguntas">See all FAQs →</a>
        </div>
      </div>
    </section>

    <!-- ============= FINAL CTA ============= -->
    <section class="section">
      <div class="container">
        <div class="cta-band reveal">
          <div>
            <h2 data-en="Ready to drop one off?" data-es="¿Listo para entregar uno?">Ready to drop one off?</h2>
            <p data-en="Two clicks, sixty seconds, and a dumpster in your driveway today. Most of the time, anyway." data-es="Dos clics, sesenta segundos, y un contenedor en tu entrada hoy. La mayoría de las veces.">Two clicks, sixty seconds, and a dumpster in your driveway today. Most of the time, anyway.</p>
          </div>
          <div class="cta-band-actions">
            <a href="tel:{{ site.phone.tel }}" class="cta-band-phone">{{ site.phone.display }}</a>
            <a href="#quote" class="btn btn-lg" data-en="Get a Free Quote" data-es="Cotización Gratis">
              Get a Free Quote
              <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
{% endblock %}
