---
permalink: /404.html
title: "Page not found · JP Roll-Off Service"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#CC0000" />
  <title>{{ title }}</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" />
  <link rel="stylesheet" href="/css/tokens.css?v={{ site.assetVersion }}" />
  <link rel="stylesheet" href="/css/reset.css?v={{ site.assetVersion }}" />
  <link rel="stylesheet" href="/css/base.css?v={{ site.assetVersion }}" />
  <link rel="stylesheet" href="/css/components.css?v={{ site.assetVersion }}" />
  <link rel="stylesheet" href="/css/pages.css?v={{ site.assetVersion }}" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    .err {
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: var(--color-black);
      color: var(--color-white);
      text-align: center;
      padding: var(--space-12) var(--container-px);
      position: relative;
      overflow: hidden;
    }
    .err::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(204,0,0,0.25), transparent 60%);
    }
    .err > * { position: relative; z-index: 1; }
    .err-num {
      font-family: var(--font-display);
      font-size: clamp(8rem, 24vw, 16rem);
      line-height: 0.9;
      color: var(--color-red);
      letter-spacing: var(--ls-tight);
    }
    .err h1 {
      font-size: var(--fs-56);
      margin-bottom: var(--space-5);
    }
    .err p { color: var(--color-gray-300); font-size: var(--fs-18); max-width: 48ch; margin: 0 auto var(--space-8); }
    .err-actions { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }
  </style>
</head>
<body>
  <main class="err">
    <div>
      <div class="err-num">404</div>
      <h1 data-en="This load got lost." data-es="Esta carga se perdió.">This load got lost.</h1>
      <p data-en="The page you're looking for isn't here. But we can still get a dumpster to your driveway." data-es="La página que buscas no está aquí. Pero aún podemos llevar un contenedor a tu entrada.">The page you're looking for isn't here. But we can still get a dumpster to your driveway.</p>
      <div class="err-actions">
        <a href="/" class="btn btn-lg" data-en="Back to Home →" data-es="Volver al Inicio →">Back to Home →</a>
        <a href="tel:{{ site.phone.tel }}" class="btn btn-lg btn-outline-light" data-en="Call {{ site.phone.display }}" data-es="Llamar {{ site.phone.display }}">Call {{ site.phone.display }}</a>
      </div>
    </div>
  </main>
  <script src="/js/main.js?v={{ site.assetVersion }}" defer></script>
</body>
</html>
